<%= turbo_stream.update Transaction.new, "" %>

<%= turbo_stream.update "transaction_list" do %>
  <%= render partial: "transactions/transaction_list", locals: { transactions: current_user.transactions } %>
<% end %>

<%= turbo_stream.prepend "flash" do %>
  <div class="bg-green-50 border border-green-200 text-green-800 rounded-lg p-4 mb-4">
    Transaction was successfully created.
  </div>
<% end %>

