<%= turbo_stream.update "accounts_banner", render(Accounts::BannerComponent.new(accounts: current_user.accounts)) %>
<%= turbo_stream.remove @account %>

<%# Show flash notice %>
<%= turbo_stream.prepend "flash" do %>
  <div class="bg-green-50 border border-green-200 text-green-800 rounded-lg p-4 mb-4">
    Account was successfully deleted.
  </div>
<% end %>
