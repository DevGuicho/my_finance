<%= form_with(model: account, class: "space-y-6") do |form| %>
  <% if account.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 mb-4">
      <h3 class="font-medium mb-2"><%= pluralize(account.errors.count, "error") %> prohibited this account from being
        saved:</h3>
      <ul class="list-disc list-inside">
        <% account.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
    <%= form.text_field :name,
                        class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-brand focus:border-brand block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white",
                        placeholder: "e.g., Salary, Groceries, Entertainment",
                        autofocus: true %>
  </div>

  <div>
    <%= form.label :kind, "Type", class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
    <%= form.select :kind,
                    Account.kinds.keys.map { |k| [k.titleize, k] },
                    {include_blank: "Select an option",},
                    class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-brand focus:border-brand block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:text-white",
                    required: true %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :current_balance, class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
      <%= form.number_field :current_balance,
                            class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-brand focus:border-brand block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white",
                            placeholder: "0.00",
                            step: "0.01",
                            value: account.current_balance.to_f %>
    </div>

    <div>
      <%= form.label :current_balance_currency, "Currency", class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
      <%= form.select :current_balance_currency,
                      [["Pesos (MXN)", "MXN"], ["Dólares (USD)", "USD"], ["Euros (EUR)", "EUR"]],
                      { selected: account.current_balance_currency || "MXN" },
                      class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-brand focus:border-brand block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:text-white" %>
    </div>
  </div>

  <div class="flex justify-end gap-3">
    <button type="button" data-action="click->modal#close"
            class="text-gray-500 bg-white hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-200 rounded-lg border border-gray-200 text-sm font-medium px-5 py-2.5 hover:text-gray-900 focus:z-10 dark:bg-gray-700 dark:text-gray-300 dark:border-gray-500 dark:hover:text-white dark:hover:bg-gray-600 dark:focus:ring-gray-600">Cancel
    </button>
    <%= form.submit account.persisted? ? "Update Account" : "Create Account",
                    class: "text-white bg-brand hover:bg-brand-strong focus:ring-4 focus:outline-none focus:ring-brand-medium font-medium rounded-lg text-sm px-5 py-2.5 text-center cursor-pointer" %>
  </div>
<% end %>
