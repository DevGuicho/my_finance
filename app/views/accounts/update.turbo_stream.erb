<%# Remove the modal from the DOM %>
<%= turbo_stream.update "accounts_modal", "" %>

<%# Update the account card %>
<%= turbo_stream.replace @account do %>
  <%= render Accounts::AccountComponent.new(account: @account) %>
<% end %>

<%# Show flash notice %>
<%= turbo_stream.prepend "flash" do %>
  <div class="bg-green-50 border border-green-200 text-green-800 rounded-lg p-4 mb-4">
    Account was successfully updated.
  </div>
<% end %>

<%= turbo_stream.update "accounts_banner" do %>
  <%= render Accounts::BannerComponent.new(accounts: current_user.accounts) %>
<% end %>