<section class="flex justify-between align-middle items-center mb-8">
  <div>
    <h2 class="text-3xl font-bold mb-2">Accounts</h2>
    <p class="text-body-subtle">Manage your financial accounts</p>
  </div>
  <%= link_to new_account_path,
              data: { turbo_frame: "accounts_modal" },
              class: "cursor-pointer inline-flex items-center  text-white bg-brand hover:bg-brand-strong box-border border border-transparent focus:ring-4 focus:ring-brand-medium shadow-xs font-medium leading-5 rounded-base text-sm px-3 py-2 focus:outline-none" do %>
    <%= lucide_icon "plus", class: "w-4 h-4 me-1.5 -ms-0.5" %>
    Add Account
  <% end %>
</section>

<div id="accounts_banner">
  <%= render Accounts::BannerComponent.new(accounts: @accounts) %>
</div>

<section>
  <% if @accounts.any? %>
    <%= render partial: "accounts/account_list", locals: { accounts: @accounts } %>
  <% else %>
    <p class="text-gray-500">No accounts found</p>
  <% end %>
</section>

<%= turbo_frame_tag "accounts_modal" %>
