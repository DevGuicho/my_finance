<button data-drawer-target="default-sidebar" data-drawer-toggle="default-sidebar" aria-controls="default-sidebar" type="button" class="inline-flex items-center p-2 mt-2 ml-3 text-sm text-gray-500 rounded-lg sm:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600">
  <span class="sr-only">Open sidebar</span>
  <svg class="w-6 h-6" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
    <path clip-rule="evenodd" fill-rule="evenodd" d="M2 4.75A.75.75 0 012.75 4h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 4.75zm0 10.5a.75.75 0 01.75-.75h7.5a.75.75 0 010 1.5h-7.5a.75.75 0 01-.75-.75zM2 10a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 10z"></path>
  </svg>
</button>
<aside id="default-sidebar" class="fixed top-0 left-0 z-40 w-64 h-screen transition-transform -translate-x-full sm:translate-x-0" aria-label="Sidenav">
  <div class="overflow-y-auto py-5 px-3 h-full bg-white border-r border-gray-200 dark:bg-gray-800 dark:border-gray-700">
    <ul class="space-y-2">
      <li>
        <%= link_to root_path, class: sidebar_link_classes(sidebar_active?(:dashboard)) do %>
          <%= lucide_icon "layout-dashboard", class: "w-6 h-6 text-gray-800 dark:text-white" %>
          <span class="ml-3">Dashboard</span>
        <% end %>
      </li>
      <li>
        <%= link_to transactions_path, class: sidebar_link_classes(sidebar_active?(:transactions)) do %>
          <%= lucide_icon "dollar-sign", class: "w-6 h-6 text-gray-800 dark:text-white" %>
          <span class="ml-3">Transactions</span>
        <% end %>
      </li>

      <li>
        <%= link_to accounts_path, class: sidebar_link_classes(sidebar_active?(:accounts)) do %>
          <%= lucide_icon "wallet", class: "w-6 h-6 text-gray-800 dark:text-white" %>
          <span class="ml-3">Accounts</span>
        <% end %>
      </li>

      <li>
        <%= link_to categories_path, class: sidebar_link_classes(sidebar_active?(:categories)) do %>
          <%= lucide_icon "folder", class: "w-6 h-6 text-gray-800 dark:text-white" %>
          <span class="ml-3">Categories</span>
        <% end %>
      </li>

      <li>
        <%= link_to root_path, class: sidebar_link_classes(sidebar_active?(:settings)) do %>
          <%= lucide_icon "settings", class: "w-6 h-6 text-gray-800 dark:text-white" %>
          <span class="ml-3">Settings</span>
        <% end %>
      </li>
    </ul>

  </div>
  <div class="hidden absolute bottom-0 left-0 flex-col justify-center p-4 space-x-4 w-full lg:flex bg-white dark:bg-gray-800 z-20 border-r border-gray-200 dark:border-gray-700">
    <div class="flex items-center gap-2.5 mb-2">
      <div class="relative inline-flex items-center justify-center w-10 h-10 overflow-hidden bg-neutral-tertiary rounded-full">
        <span class="font-medium text-body">JD</span>
      </div>
      <div class="font-medium text-heading">
        <div><%= current_user.email %></div>
        <div class="text-sm font-normal text-body"><%= current_user.email %></div>
      </div>
    </div>
    <%= link_to destroy_user_session_path,
                data: { turbo_method: :delete },
                method: :delete, class: "cursor-pointer flex gap-2 align-middle items-center text-fg-brand bg-neutral-primary border border-brand hover:bg-brand hover:text-white focus:ring-4 focus:ring-brand-subtle font-medium leading-5 rounded-base text-xs px-3 py-1.5 focus:outline-none" do %>
      <%= lucide_icon "log-out", class: "h-3.5 w-3.5 -ms-0.5" %>
      Log out
    <% end %>
  </div>
</aside>
