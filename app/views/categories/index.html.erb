<section class="flex justify-between align-middle items-center mb-8">
  <div>
    <h2 class="text-3xl font-bold mb-2">Categories</h2>
    <p class="text-body-subtle">Organize your transactions with categories</p>
  </div>
  <%= link_to new_category_path,
              data: { turbo_frame: "category_modal" },
              class: "cursor-pointer inline-flex items-center  text-white bg-brand hover:bg-brand-strong box-border border border-transparent focus:ring-4 focus:ring-brand-medium shadow-xs font-medium leading-5 rounded-base text-sm px-3 py-2 focus:outline-none" do %>
    <%= lucide_icon "plus", class: "w-4 h-4 me-1.5 -ms-0.5" %>
    Add Category
  <% end %>
</section>

<%= turbo_frame_tag "category_banner" do %>
  <%= render Categories::BannerComponent.new(categories: @categories) %>
<% end %>

<section class="mb-8">
  <%= render Ui::CardComponent.new do %>
    <h2 class="text-md font-semibold mb-6">All Categories</h2>

    <%= render Ui::FilterTabsComponent.new(tabs: ["All", "Income", "Expense"], active_tab: "All") %>

    <%= turbo_frame_tag "categories_list" do %>
      <%= render partial: "categories/category_list", locals: { categories: @categories } %>
    <% end %>

  <% end %>

</section>

<%= turbo_frame_tag "category_modal" %>
