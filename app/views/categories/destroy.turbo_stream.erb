<%# Show flash notice %>
<%= turbo_stream.prepend "flash" do %>
  <div class="bg-green-50 border border-green-200 text-green-800 rounded-lg p-4 mb-4">
    Category was successfully deleted.
  </div>
<% end %>

<%= turbo_stream.remove @category %>

<%= turbo_stream.update "category_banner" do %>
  <%= render Categories::BannerComponent.new(categories: current_user.categories) %>
<% end %>