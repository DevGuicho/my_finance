<%# Remove the modal from the DOM %>
<%= turbo_stream.update Category.new, "" %>

<%# Update the categories list %>
<%= turbo_stream.update "categories_list" do %>
  <% current_user.categories.each do |category| %>
    <div class="bg-neutral-primary-soft block max-w-sm p-6 border border-green-200 rounded-base shadow-xs hover:shadow-md">
      <div class="flex gap-4 mb-4 pb-4 border-b border-b-gray-200">
        <div class="relative inline-flex items-center justify-center w-13 h-13 overflow-hidden bg-green-50 rounded-base">
          <span class="font-medium text-2xl">💼</span>
        </div>
        <div>
          <h4 class="font-semibold text-lg"><%= category.name %></h4>
          <span class="bg-success-soft text-fg-success-strong text-xs font-medium px-1.5 py-0.5 rounded"><%= category.kind.titleize %></span>
        </div>
      </div>

      <div>
        <h6 class="text-sm mb-2">Total Amount</h6>
        <p class="text-2xl font-bold text-green-500 mb-1">+$4,000.00</p>
        <small>1 transaction</small>
      </div>
    </div>
  <% end %>
<% end %>

<%# Show flash notice %>
<%= turbo_stream.prepend "flash" do %>
  <div class="bg-green-50 border border-green-200 text-green-800 rounded-lg p-4 mb-4">
    Category was successfully created.
  </div>
<% end %>

