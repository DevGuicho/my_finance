<%= turbo_stream.replace @category do %>
  <%= render Categories::CategoryComponent.new(category: @category) %>
<% end %>

<%# Show flash notice %>
<%= turbo_stream.prepend "flash" do %>
  <div class="bg-green-50 border border-green-200 text-green-800 rounded-lg p-4 mb-4">
    Category was successfully updated.
  </div>
<% end %>

<%= turbo_stream.update "category_modal", "" %>