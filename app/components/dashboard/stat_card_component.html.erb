<%= render(Ui::CardComponent.new(class: "grow")) do %>
  <div class="flex justify-between mb-4">
    <h6 class="text-sm text-body"><%= @title %></h6>

    <%= content %>

  </div>
  <p class="text-2xl font-bold <%= amount_classes %>"><%= @amount %></p>
  <small class="text-body-subtle"><%= @subtitle %></small>
<% end %>
