<div id="<%= helpers.dom_id(category) %>" class="bg-neutral-primary-soft block max-w-sm p-6 border border-<%= category_color %>-200 rounded-base shadow-xs hover:shadow-md">
  <div class="flex gap-4 mb-4 pb-4 border-b border-b-gray-200 justify-between">
    <div class="flex gap-4">
      <div class="relative inline-flex items-center justify-center w-13 h-13 overflow-hidden bg-<%= category_color %>-50 rounded-base">
        <span class="font-medium text-2xl">💼</span>
      </div>
      <div>
        <h4 class="font-semibold text-lg"><%= category.name %></h4>
        <span class="bg-<%= category_badge_color %>-soft text-fg-<%= category_badge_color %>-strong text-xs font-medium px-1.5 py-0.5 rounded"><%= category.kind %></span>
      </div>
    </div>

    <button data-dropdown-toggle="<%= helpers.dom_id(category) %>_dropdown" class="text-heading bg-transparent box-border border border-transparent hover:bg-neutral-secondary-medium focus:ring-4 focus:ring-neutral-tertiary font-medium leading-5 rounded-base text-xs px-1.5 py-1.5 focus:outline-none" type="button">
      <%= helpers.lucide_icon "ellipsis-vertical", class: "w-5 h-5 " %>
    </button>

    <!-- Dropdown menu -->
    <div id="<%= helpers.dom_id(category) %>_dropdown" class="z-10 hidden bg-neutral-primary-medium border border-default-medium rounded-base shadow-lg w-44">
      <ul class="p-2 text-sm text-body font-medium">
        <li>
          <%= link_to "Edit", helpers.edit_category_path(category),
                      data: { turbo_frame: "category_modal" },
                      class: "inline-flex items-center w-full p-2 hover:bg-neutral-tertiary-medium hover:text-heading rounded" %>

        </li>
        <li>
          <%= helpers.link_to "Delete", helpers.category_path(category), class: "inline-flex items-center w-full p-2 hover:bg-neutral-tertiary-medium hover:text-heading rounded",
                              data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
        </li>
      </ul>
    </div>
  </div>
  <div>
    <h6 class="text-sm mb-2">Total Amount</h6>
    <p class="text-2xl font-bold text-<%= category_color %>-500 mb-1"> <%= helpers.humanized_money_with_symbol(category_total) %> </p>
    <small><%= number_of_transactions %> <%= "transaction".pluralize(number_of_transactions) %></small>
  </div>
</div>
